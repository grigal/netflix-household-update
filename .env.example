# IMAP Email Configuration
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password-here

# Mailbox Settings
MAILBOX_NAME=INBOX
MoveEmailsToMailbox=True
MoveToMailboxName=Netflix

# Netflix Credentials
NETFLIX_USER=your-netflix-email@gmail.com
NETFLIX_PASS=your-netflix-password-here

# Application Settings
POLLING_TIME_IN_SECONDS=60
LOG_LEVEL=INFO

# Database (for new refactored version)
DATABASE_PATH=netflix_updater.db
